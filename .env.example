# Copy this file to .env (gitignored) to override docker-compose.yml's
# defaults. Nothing here is required for local development — `docker
# compose build`/`up --build` works with no .env file at all.

# Which image `docker compose up`/`pull` uses for the m261sim service.
# Local development: leave unset, or set to a locally built tag.
# Deployment: deploy.yml resolves an allowed GHCR tag to its immutable OCI
# digest before writing this variable, e.g.:
#   M261SIM_IMAGE=ghcr.io/sternestehen/petz-m261-tooling@sha256:<64-hex>
# See README.md's CI/CD section for the full tag list a release publishes
# (semver and commit-SHA) and .github/workflows/deploy.yml, which writes the
# digest reference into the deployment host's own .env.
M261SIM_IMAGE=m261sim:local
